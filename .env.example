# Feature flags — set to "true" when ready to launch (requires rebuild/redeploy)
# Copy to .env for local testing: cp .env.example .env

VITE_FEATURE_NEATCLOCK_PRINTS=false
VITE_FEATURE_LOCKSCREEN_GOODIES=false
VITE_FEATURE_PREMIUM_THEMES=false
VITE_FEATURE_SPONSOR_FOOTER=false
VITE_FEATURE_AFFILIATE_LINKS=false
VITE_FEATURE_PRODUCT_FEEDBACK=

# Optional config when flags are enabled
# VITE_PRINTS_SHOP_URL=https://shop.example.com/neatclock-prints
# VITE_LOCKSCREEN_URL=https://cdn.example.com/lockscreen.jpg
# VITE_SPONSOR_NAME=Minimalist Notebook Co.
# VITE_SPONSOR_TAGLINE=analogue tools for organized minds
# Public site URL (canonical, OG tags in index.html — override on Vercel when custom domain is live)
VITE_SITE_URL=https://neatclock.pro

# Interest / greenlight form (Formspree or FormSubmit — see WAITLIST.md)
VITE_INTEREST_FORM_ENDPOINT=
# Fastest path: your inbox only — no Formspree account (builds formsubmit.co/ajax URL)
# VITE_INTEREST_FORM_EMAIL=you@example.com

# Legacy alias — falls back if INTEREST_FORM_ENDPOINT unset
# VITE_WAITLIST_URL=

# Privacy-friendly analytics (Plausible) — set domain when live; skipped on localhost
# VITE_PLAUSIBLE_DOMAIN=neatclock.pro

# NeatClock Business server-only commercial configuration
# STRIPE_SECRET_KEY=
# NEATCLOCK_STRIPE_WEBHOOK_SECRET=
# NEATCLOCK_ENTITLEMENT_SECRET=
# NEATCLOCK_BUSINESS_PRICE_CENTS=4900
# NEATCLOCK_BUSINESS_CHECKOUT_ENABLED=false

# Legacy Supabase configuration (for backward compatibility)
# NEATCLOCK_SUPABASE_URL=
# NEATCLOCK_SUPABASE_SERVICE_ROLE_KEY=
# NEATCLOCK_SUPABASE_PUBLISHABLE_KEY=

# Neon Postgres configuration (recommended for new deployments)
# DATABASE_URL=postgresql://user:password@host:port/database
# NEATCLOCK_RECOVERY_SECRET=<32+ character secret for recovery token signing>

# Resend email configuration (for recovery link delivery)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=<Resend API key>
# OTP_FROM=no-reply@neatclock.pro
